# FluentFlow - AI English Communication Coach
# Environment Configuration

# Server Settings
APP_NAME=FluentFlow Backend
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/fluentflow.db

# AI Provider Configuration ("gemini", "openai", "groq", or "local_mock")
AI_PROVIDER=gemini

# Google Gemini API (Recommended for Multimodal Live / Fast low latency)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=

# Groq API Key (Optional fast Whisper/Llama fallback)
GROQ_API_KEY=

# ElevenLabs API Key (Optional ultra-realistic TTS)
ELEVENLABS_API_KEY=

# Speech & Audio Synthesis
# Options: "edge_tts" (High quality, free, realistic neural voices), "browser", "elevenlabs"
TTS_PROVIDER=edge_tts
DEFAULT_VOICE=en-US-AriaNeural
DEFAULT_SPEECH_RATE=+0%

# Privacy & Session Limits
MAX_SESSION_DURATION_SECONDS=1800
STORE_TRANSCRIPTS_DEFAULT=true
RATE_LIMIT_TURNS_PER_MINUTE=25
